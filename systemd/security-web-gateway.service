[Unit]
Description=Security Web Gateway Manager
After=network-online.target squid.service
Wants=network-online.target
[Service]
Type=simple
User=proxy-mgmt
Group=proxy-mgmt
SupplementaryGroups=proxy
WorkingDirectory=/opt/security-web-gateway/current
EnvironmentFile=/etc/security-web-gateway/production.env
ExecStart=/opt/security-web-gateway/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8200 --workers 2
Restart=always
RestartSec=4
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/security-web-gateway/prod
ReadWritePaths=/var/log/security-web-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=multi-user.target
