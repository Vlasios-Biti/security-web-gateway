[Unit]
Description=Security Web Gateway Privileged Deployment Worker
[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/local/sbin/security-web-gateway-deploy-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0027
RuntimeDirectory=security-web-gateway
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/squid/managed
ReadWritePaths=/etc/security-web-gateway
ReadWritePaths=/var/log/nginx
ReadWritePaths=-/run/nginx.pid
ReadWritePaths=/var/lib/security-web-gateway/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
