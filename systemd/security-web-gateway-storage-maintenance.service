[Unit]
Description=Security Web Gateway Telemetry and Squid Log Storage Guardrails
After=security-web-gateway.service squid.service

[Service]
Type=oneshot
User=proxy-mgmt
Group=proxy-mgmt
SupplementaryGroups=proxy
WorkingDirectory=/opt/security-web-gateway/current
EnvironmentFile=/etc/security-web-gateway/production.env
Environment=PYTHONPATH=/opt/security-web-gateway/current
ExecStart=/opt/security-web-gateway/venv/bin/python /opt/security-web-gateway/current/bin/maintain_storage.py
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/security-web-gateway/prod
ReadWritePaths=/var/log/squid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
