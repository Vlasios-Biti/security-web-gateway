# Security Web Gateway - explicit proxy base configuration
# Managed policy is generated by the SWG application and included below.

visible_hostname __FQDN__
http_port __BIND_IP__:__PROXY_PORT__

acl port_http port 80
acl port_https port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !port_https

dns_nameservers __SQUID_DNS_SERVERS_SPACE__

client_persistent_connections on
server_persistent_connections on
cache deny all

access_log stdio:/var/log/squid/access.log squid
cache_log /var/log/squid/cache.log

include /etc/squid/managed/security-web-gateway.conf

# Default deny. All business access must be generated by the managed policy.
http_access deny all
