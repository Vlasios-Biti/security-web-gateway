{
  "product": "Security Web Gateway",
  "version": "3.12.12",
  "schema_migration": "019",
  "target_os": "Ubuntu 24.04 LTS / Ubuntu 26.04 LTS",
  "deployment_model": "single-vm-on-prem-appliance",
  "management_backend": "127.0.0.1:8200",
  "default_proxy_port": 3128,
  "pac_port": 8081,
  "policy_model": "default-deny-explicit-allow",
  "runtime_state_in_git": false,
  "browser_discovery": "playwright-chromium",
  "har_raw_storage": false,
  "dashboard_aggregation": "background-cache",
  "local_dns_cache": "unbound-optional-default-on-fresh-install",
  "dependency_candidates_auto_allow": false,
  "recommended_vm": {
    "vcpu": 4,
    "ram_gib": 8,
    "disk_gib": 100,
    "nic": "VirtIO 1Gbps+",
    "swap_gib": 2
  },
  "data_plane_priority": "squid-high-background-workers-low",
  "proxy_content_cache": false,
  "performance_sampling": true,
  "policy_simulator": true,
  "why_blocked": true,
  "dependency_candidates": "review-only-no-auto-allow",
  "application_discovery_auto_stage": true,
  "primary_navigation": "overview-access-profiles-monitoring-alerts-snmp-connection-bypass-activity-system-tools",
  "ui_theme": "enterprise-operations-light-workspace-graphite-sidebar",
  "save_behavior": "admin-save-validate-apply-rollback",
  "operator_save_behavior": "pending-admin-approval",
  "system_console": "unified-health-performance-dns-tls-storage-recovery-alerts",
  "live_traffic_auto_refresh_seconds": 10,
  "health_notifications": "optional-gui-smtp-tls-and-slack-webhook",
  "network_copy": true,
  "access_assignment": "exclusive-profile-or-network-with-explicit-legacy-preservation",
  "snmp": "optional-readonly-v2c-and-traps",
  "default_application": "unassigned-google-search-starter",
  "profile_network_onboarding": "one-page-one-transaction-one-apply",
  "pac_distribution": {
    "http_port": 8081,
    "https_port": 443,
    "path": "/proxy.pac",
    "shared_endpoint_downloads": true
  },
  "certificate_management": "admin-fixed-path-pem-renewal-with-nginx-validation-and-rollback"
}
