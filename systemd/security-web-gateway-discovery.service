[Unit]
Description=Security Web Gateway Browser Discovery Queue Worker
After=network-online.target security-web-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
User=proxy-mgmt
Group=proxy-mgmt
WorkingDirectory=/opt/security-web-gateway/current
EnvironmentFile=/etc/security-web-gateway/production.env
Environment=PYTHONPATH=/opt/security-web-gateway/current
ExecStart=/opt/security-web-gateway/venv/bin/python /opt/security-web-gateway/current/bin/process_discovery_queue.py --max-runs 1
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=2G
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/security-web-gateway/prod
ReadWritePaths=/var/lib/security-web-gateway/playwright
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
